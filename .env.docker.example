APP_ENV=production
NODE_ENV=production
PORT=4000

CLIENT_URL=https://luizfelippedev.vercel.app
ASSET_BASE_URL=http://localhost
CORS_ORIGINS=https://luizfelippedev.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Docker image used by manual activation scripts
BACKEND_IMAGE=portfolio-backend:local

DATABASE_URL=mongodb://mongo:27017/portfolio
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=local-dev-access-secret-change-me-1234567890
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Unique views by IP (same IP won't count again within TTL)
VIEW_UNIQUE_TTL_SECONDS=2592000
VIEW_HASH_SALT=replace-with-random-salt

NOTIFICATION_EMAIL=admin@example.com
NEWSLETTER_CONFIRMATION_URL=https://luizfelippedev.vercel.app/newsletter/confirm
PASSWORD_RESET_URL=https://luizfelippedev.vercel.app/auth/reset-password

# External live metrics
GITHUB_USERNAME=luizFelippedev
GITHUB_TOKEN=
GITHUB_METRICS_TTL_SECONDS=300
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_METRICS_TTL_SECONDS=300

# Hosted AI assistant (Groq)
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REQUEST_TIMEOUT_MS=45000
GROQ_TEMPERATURE=0.45
GROQ_TOP_P=0.9

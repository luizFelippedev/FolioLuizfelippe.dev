APP_ENV=development
NODE_ENV=development
PORT=4010

CLIENT_URL=http://localhost:5173
ASSET_BASE_URL=http://localhost:4010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://localhost:4010

# Host-local access to dockerized dependencies
DATABASE_URL=mongodb://localhost:27018/portfolio
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=local-dev-access-secret-change-me-1234567890
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Unique views by IP (same IP won't count again within TTL)
VIEW_UNIQUE_TTL_SECONDS=2592000
VIEW_HASH_SALT=replace-with-random-salt

NOTIFICATION_EMAIL=admin@example.com
NEWSLETTER_CONFIRMATION_URL=http://localhost:5173/newsletter/confirm
PASSWORD_RESET_URL=http://localhost:5173/auth/reset-password

# External live metrics
GITHUB_USERNAME=luizFelippedev
GITHUB_TOKEN=
GITHUB_METRICS_TTL_SECONDS=300
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_METRICS_TTL_SECONDS=300

# Hosted AI assistant (Groq)
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REQUEST_TIMEOUT_MS=45000
GROQ_TEMPERATURE=0.45
GROQ_TOP_P=0.9

ADMIN_EMAIL=admin@example.com
ADMIN_EMAIL_ALIASES=admin-alias@example.com
ADMIN_PASSWORD=replace-with-strong-password

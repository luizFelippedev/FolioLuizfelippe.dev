APP_ENV=production
NODE_ENV=production
PORT=4000

CLIENT_URL=https://luizfelippedev.vercel.app
ASSET_BASE_URL=https://your-backend-domain
CORS_ORIGINS=https://luizfelippedev.vercel.app

BACKEND_IMAGE=luizfelippedev/portfolio:latest

DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/portfolio?retryWrites=true&w=majority
REDIS_URL=rediss://:<password>@<host>:<port>

JWT_ACCESS_SECRET=replace-with-64-char-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-64-char-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Unique views by IP (same IP won't count again within TTL)
VIEW_UNIQUE_TTL_SECONDS=2592000
VIEW_HASH_SALT=replace-with-random-salt

NOTIFICATION_EMAIL=admin@example.com
NEWSLETTER_CONFIRMATION_URL=https://luizfelippedev.vercel.app/newsletter/confirm
PASSWORD_RESET_URL=https://luizfelippedev.vercel.app/auth/reset-password

# External live metrics
GITHUB_USERNAME=luizFelippedev
GITHUB_TOKEN=
GITHUB_METRICS_TTL_SECONDS=300
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_METRICS_TTL_SECONDS=300

# Hosted AI assistant (Groq)
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REQUEST_TIMEOUT_MS=45000
GROQ_TEMPERATURE=0.45
GROQ_TOP_P=0.9

ADMIN_EMAIL=admin@example.com
ADMIN_EMAIL_ALIASES=admin-alias@example.com
ADMIN_PASSWORD=replace-with-strong-password
